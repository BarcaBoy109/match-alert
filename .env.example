DISCORD_TOKEN=your_bot_token
DEFAULT_TEAM_ID=83
DEFAULT_TEAM_NAME=FC Barcelona
POLL_MINUTES=10
REMINDER_RETENTION_HOURS=3
# ESPN connection pooling and in-memory scoreboard cache.
ESPN_MAX_CONCURRENCY=4
ESPN_LIVE_CACHE_SECONDS=60
ESPN_FUTURE_CACHE_SECONDS=600
ESPN_RECENT_CACHE_SECONDS=3600
ESPN_HISTORICAL_CACHE_SECONDS=86400
ESPN_STALE_IF_ERROR_SECONDS=1800
# For hosted deployment, use Supabase's session pooler connection string.
# Leave blank for local JSON state.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional local fallback; defaults to state.json
STATE_FILE=state.json
